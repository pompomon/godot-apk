[resource]
script = ExtResource("1")
event_id = &"frostbound_shelter"
display_name = "The trailkeeper's shelter"
description = "A low stone hut stands beneath an overhang, its entrance marked by the mountain guides' blue sign."
outcomes = Array[ExtResource("2")]([SubResource("a"), SubResource("b")])

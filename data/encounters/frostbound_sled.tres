[gd_resource type="Resource" script_class="EventResource" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/models/event_resource.gd" id="1"]
[ext_resource type="Script" path="res://scripts/models/event_outcome_resource.gd" id="2"]

[sub_resource type="Resource" id="a"]
script = ExtResource("2")
outcome_id = &"frostbound_sled_payment"
journal_text = "Together they lift the runners free. The courier pays the Party for getting the mountain mail moving again."
weight = 2.0
result = {"gold": 9}

[sub_resource type="Resource" id="b"]
script = ExtResource("2")
outcome_id = &"frostbound_sled_letters"
journal_text = "The courier has already freed the runners. They exchange news of the lower valleys before moving on."
weight = 1.0
result = {"gold": 0}

[resource]
script = ExtResource("1")
event_id = &"frostbound_sled"
display_name = "The courier's sled"
description = "A mail courier crouches beside a sled whose runners have sunk into a drift across the switchback."
outcomes = Array[ExtResource("2")]([SubResource("a"), SubResource("b")])

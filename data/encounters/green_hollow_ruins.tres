result = {"gold": 0}

[resource]
script = ExtResource("1")
event_id = &"green_hollow_ruins"
display_name = "Quiet ruins"
description = "Ivy covers the walls of an empty wayside shelter."
outcomes = Array[ExtResource("2")]([SubResource("a"), SubResource("b")])

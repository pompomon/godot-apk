[gd_resource type="Resource" script_class="EventResource" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/models/event_resource.gd" id="1"]
[ext_resource type="Script" path="res://scripts/models/event_outcome_resource.gd" id="2"]

[sub_resource type="Resource" id="a"]
script = ExtResource("2")
outcome_id = &"shimmer"
journal_text = "Something glitters on the bank: a lost coin."
weight = 1.0
result = {"gold": 1}

[sub_resource type="Resource" id="b"]
script = ExtResource("2")
outcome_id = &"rest"
journal_text = "The clear water makes a pleasant resting place."
weight = 2.0
result = {"gold": 0}

[resource]
script = ExtResource("1")
event_id = &"green_hollow_spring"
display_name = "Clearwater spring"
description = "Water bubbles between smooth stones."
outcomes = Array[ExtResource("2")]([SubResource("a"), SubResource("b")])

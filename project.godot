; Engine configuration file.
; Edit this file through the Godot editor when possible.

config_version=5

[application]

config/name="Adventurer's March"
; Preserve pre-branding user:// locations, including case-sensitive desktop paths.
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/Hello World"
config/custom_user_dir_name.windows="Godot/app_userdata/Hello World"
config/custom_user_dir_name.macos="Godot/app_userdata/Hello World"
config/icon="res://assets/branding/icon_1024.png"
config/quit_on_go_back=false
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

; State precedes persistence; simulation precedes expedition orchestration.
; UIManager binds the UI root only after main.tscn is ready.
GameState="*res://autoload/GameState.gd"
SaveManager="*res://autoload/SaveManager.gd"
CombatSimulator="*res://autoload/CombatSimulator.gd"
ExpeditionManager="*res://autoload/ExpeditionManager.gd"
UIManager="*res://autoload/UIManager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.12, 1)
textures/vram_compression/import_etc2_astc=true

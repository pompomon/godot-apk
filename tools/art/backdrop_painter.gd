extends RefCounted
## Landscape silhouettes are authored on a 160x72 grid and enlarged with nearest pixels.

const CANVAS := preload("res://tools/art/pixel_canvas.gd")


static func paint(recipe: Dictionary) -> Image:
	var c := CANVAS.new(160, 72, "mist")
	match recipe.subject:
		"green_hollow": _woodland(c)
		"ashen_reach": _ash(c)
		"frostbound_pass": _snow(c)
		_: _unknown(c)
	return c.doubled()


static func _woodland(c: RefCounted) -> void:
	c.rect(0, 0, 160, 40, "mist")
	c.rect(43, 0, 83, 29, "cream")
	c.disc(111, 15, 8, "gold_light")
	c.poly([[0, 34], [0, 26], [16, 17], [30, 24], [45, 18], [64, 29],
		[79, 25], [96, 32], [115, 24], [139, 21], [160, 31], [160, 49]], "ice")
	c.poly([[0, 38], [22, 28], [47, 35], [69, 28], [88, 36], [111, 30],
		[136, 25], [160, 35], [160, 56], [0, 56]], "leaf")
	for tree: Array in [[34, 14, 27], [46, 19, 23], [61, 21, 22], [119, 15, 31], [134, 10, 36]]:
		_pine(c, tree[0], tree[1], tree[2], "moss", "leaf")
	c.poly([[0, 46], [27, 40], [51, 45], [69, 38], [94, 39], [118, 43],
		[160, 39], [160, 72], [0, 72]], "moss_dark")
	c.poly([[88, 39], [95, 40], [93, 46], [107, 53], [110, 62], [137, 72],
		[86, 72], [90, 62], [92, 57], [85, 51]], "teal_dark")
	c.poly([[91, 40], [94, 40], [90, 48], [103, 55], [100, 61], [119, 72],
		[95, 72], [99, 64], [95, 57], [87, 50]], "teal")
	c.line(92, 42, 90, 47, "ice")
	c.line(100, 57, 104, 59, "ice")
	c.line(93, 66, 103, 66, "ice")
	c.line(105, 69, 111, 69, "ice_light")
	c.poly([[73, 38], [80, 38], [75, 44], [72, 48], [68, 51], [76, 56],
		[63, 65], [76, 72], [31, 72], [47, 63], [57, 57], [54, 53], [66, 46]], "earth")
	c.poly([[74, 38], [78, 38], [71, 45], [64, 51], [61, 53], [69, 57],
		[55, 65], [62, 72], [38, 72], [56, 60], [62, 57], [57, 53], [69, 44]], "sand")
	c.line(47, 67, 53, 64, "gold_light", 2)
	c.line(64, 48, 68, 45, "gold_light")
	# A readable dark arch leaves the stream visible below the stone bridge.
	c.poly([[69, 48], [78, 43], [97, 43], [108, 49], [108, 57],
		[101, 57], [98, 51], [80, 51], [77, 57], [69, 57]], "ink")
	c.poly([[70, 48], [79, 45], [97, 45], [106, 49], [106, 55],
		[103, 55], [99, 49], [78, 49], [75, 55], [70, 55]], "earth_light")
	c.line(71, 47, 79, 44, "cream", 2)
	c.line(80, 44, 96, 44, "cream", 2)
	c.line(97, 45, 105, 48, "silver")
	for x in range(73, 105, 6):
		c.rect(x, 46 if x > 78 and x < 97 else 48, 1, 4, "earth")
	c.rect(71, 46, 2, 6, "silver")
	c.rect(102, 47, 2, 6, "silver")
	c.poly([[0, 51], [18, 47], [37, 55], [43, 62], [27, 67], [25, 72], [0, 72]], "pine")
	c.poly([[119, 49], [136, 44], [160, 46], [160, 72], [140, 72], [127, 61]], "pine")
	_tree(c, 16, 0, 58, 10)
	_tree(c, 144, 0, 57, 9)
	c.poly([[0, 0], [63, 0], [62, 6], [52, 10], [42, 9], [35, 15],
		[22, 12], [17, 20], [3, 17], [0, 22]], "pine")
	c.poly([[0, 0], [58, 0], [48, 5], [38, 5], [31, 9], [17, 6],
		[9, 12], [0, 9]], "moss_dark")
	c.poly([[118, 0], [160, 0], [160, 27], [151, 22], [147, 13],
		[133, 15], [132, 9], [119, 8]], "pine")
	c.poly([[122, 0], [160, 0], [160, 8], [150, 6], [138, 9], [132, 5]], "moss")
	for fern: Array in [[6, 58], [28, 58], [22, 67], [119, 59], [140, 65], [154, 56]]:
		_fern(c, fern[0], fern[1])
	for rock: Array in [[32, 64], [73, 61], [126, 67], [115, 51]]:
		c.poly([[rock[0], rock[1]], [rock[0] + 3, rock[1] - 3],
			[rock[0] + 7, rock[1] - 2], [rock[0] + 9, rock[1] + 1]], "slate")
		c.line(rock[0] + 2, rock[1] - 2, rock[0] + 6, rock[1] - 2, "steel")
	c.rect(37, 49, 3, 2, "gold_light")
	c.rect(38, 51, 1, 2, "pine")
	c.rect(129, 46, 3, 2, "gold_light")


static func _ash(c: RefCounted) -> void:
	c.rect(0, 0, 160, 72, "sand")
	c.rect(0, 0, 160, 16, "copper")
	c.poly([[0, 16], [48, 13], [101, 17], [160, 12], [160, 26], [0, 28]], "sand")
	c.disc(121, 17, 9, "gold_light")
	c.line(109, 17, 139, 17, "sand", 2)
	c.poly([[0, 38], [14, 29], [30, 32], [53, 21], [72, 30], [90, 27],
		[110, 32], [130, 28], [160, 38], [160, 51], [0, 51]], "earth_light")
	c.poly([[0, 43], [32, 34], [62, 38], [93, 33], [124, 39], [160, 35],
		[160, 60], [0, 60]], "earth")
	# Broken arch and detached columns imply a wind-worn road, not a settlement.
	c.poly([[86, 41], [86, 19], [90, 13], [95, 10], [110, 10], [116, 17],
		[116, 42], [107, 42], [107, 21], [103, 18], [99, 18], [95, 22], [95, 41]], "ink")
	c.poly([[88, 38], [88, 20], [92, 15], [96, 12], [109, 12], [113, 18],
		[113, 39], [109, 39], [109, 20], [104, 16], [98, 16], [93, 21], [93, 38]], "earth_light")
	c.line(88, 21, 92, 16, "sand", 2)
	c.line(96, 12, 107, 12, "sand", 2)
	c.line(89, 29, 93, 29, "earth")
	c.line(109, 27, 114, 27, "earth")
	c.line(110, 35, 113, 35, "earth")
	c.poly([[101, 10], [103, 12], [101, 15], [106, 16], [108, 10]], "ink")
	c.rect(31, 28, 7, 17, "ink")
	c.rect(32, 28, 3, 15, "earth_light")
	c.rect(29, 26, 10, 3, "earth")
	c.rect(29, 26, 8, 1, "sand")
	c.poly([[44, 41], [45, 33], [48, 31], [50, 35], [50, 42]], "slate")
	c.poly([[0, 47], [38, 42], [67, 48], [94, 44], [132, 46], [160, 56],
		[160, 72], [0, 72]], "rust")
	c.poly([[0, 46], [36, 41], [67, 47], [95, 43], [131, 45], [160, 54],
		[142, 54], [112, 48], [72, 51], [36, 46], [0, 52]], "copper")
	c.poly([[85, 39], [91, 39], [86, 47], [72, 53], [83, 57], [79, 60],
		[54, 59], [56, 55], [77, 47]], "sand")
	c.poly([[0, 65], [44, 56], [80, 60], [123, 53], [160, 58], [160, 72], [0, 72]], "earth")
	c.poly([[0, 64], [43, 55], [80, 59], [120, 52], [159, 57], [134, 59],
		[119, 55], [81, 62], [44, 59], [0, 69]], "gold_dark")
	c.poly([[19, 70], [28, 60], [38, 62], [39, 69]], "ink")
	c.poly([[21, 68], [29, 61], [34, 62], [30, 68]], "slate")
	c.poly([[123, 69], [126, 60], [139, 59], [142, 64], [140, 70]], "ink")
	c.poly([[125, 66], [128, 61], [138, 61], [140, 63]], "earth_light")
	c.line(131, 61, 130, 64, "earth")
	for wind: Array in [[12, 38, 17], [54, 33, 12], [122, 35, 23], [86, 56, 15], [44, 66, 14]]:
		c.rect(wind[0], wind[1], wind[2], 1, "sand")
		c.rect(wind[0] + 3, wind[1] + 2, wind[2] / 2, 1, "gold_dark")
	c.line(154, 48, 151, 39, "ink")
	c.line(151, 43, 146, 41, "ink")
	c.line(151, 42, 155, 38, "ink")


static func _snow(c: RefCounted) -> void:
	c.rect(0, 0, 160, 72, "ice_light")
	c.rect(0, 0, 160, 16, "ice")
	c.disc(88, 15, 7, "cream")
	c.poly([[0, 40], [18, 23], [30, 29], [52, 10], [69, 30], [85, 22],
		[100, 32], [119, 11], [142, 26], [160, 20], [160, 72], [0, 72]], "teal")
	c.poly([[32, 30], [52, 10], [69, 30], [57, 24], [54, 21], [49, 25], [44, 24]], "cream")
	c.poly([[103, 29], [119, 11], [142, 26], [128, 23], [121, 19], [116, 23]], "cream")
	c.poly([[0, 44], [18, 28], [33, 41], [62, 32], [78, 38], [98, 30],
		[129, 38], [160, 30], [160, 72], [0, 72]], "ice_light")
	c.poly([[0, 47], [22, 36], [41, 46], [62, 36], [78, 43], [96, 32],
		[126, 44], [160, 36], [160, 72], [0, 72]], "silver")
	c.poly([[0, 54], [22, 42], [43, 49], [67, 40], [91, 47], [126, 43],
		[160, 51], [160, 72], [0, 72]], "cream")
	# Two hairpins, with poles on the outside of each bend.
	c.poly([[91, 32], [95, 32], [62, 43], [108, 49], [112, 53], [56, 65],
		[64, 72], [37, 72], [45, 63], [94, 52], [53, 46], [52, 42]], "teal_dark")
	c.poly([[92, 32], [94, 32], [57, 43], [104, 50], [107, 52], [51, 65],
		[56, 72], [43, 72], [48, 64], [99, 52], [56, 45], [55, 43]], "ice")
	c.line(58, 42, 90, 32, "white")
	c.line(62, 45, 98, 50, "white")
	c.line(52, 66, 103, 54, "white")
	for pole: Array in [[87, 33], [55, 43], [108, 51], [49, 65], [77, 60]]:
		c.line(pole[0], pole[1] - 7, pole[0], pole[1] + 1, "ink")
		c.line(pole[0] - 1, pole[1] - 7, pole[0] - 1, pole[1] - 2, "gold_dark")
		c.poly([[pole[0], pole[1] - 7], [pole[0] + 5, pole[1] - 6],
			[pole[0], pole[1] - 4]], "red")
		c.dot(pole[0] - 1, pole[1] - 7, "cream")
	c.poly([[0, 20], [12, 15], [23, 26], [25, 40], [38, 51], [31, 72], [0, 72]], "ink")
	c.poly([[0, 22], [11, 18], [20, 27], [23, 42], [33, 52], [27, 72], [0, 72]], "teal_dark")
	c.poly([[0, 24], [10, 19], [13, 28], [10, 48], [16, 66], [0, 70]], "teal")
	c.poly([[12, 21], [20, 28], [23, 43], [30, 50], [25, 52], [18, 44]], "ice")
	c.poly([[0, 20], [12, 15], [23, 26], [18, 27], [10, 21], [0, 26]], "white")
	c.poly([[130, 20], [143, 12], [160, 14], [160, 72], [127, 72], [117, 59],
		[125, 46]], "ink")
	c.poly([[132, 22], [144, 15], [160, 17], [160, 72], [132, 72], [121, 59],
		[128, 45]], "teal_dark")
	c.poly([[133, 25], [142, 20], [139, 44], [133, 49], [129, 64], [123, 57]], "ice")
	c.poly([[145, 19], [155, 18], [153, 45], [147, 51], [152, 70], [136, 70],
		[139, 56], [144, 46]], "teal")
	c.poly([[130, 20], [143, 12], [160, 14], [160, 20], [145, 18], [133, 26]], "white")
	c.line(132, 28, 130, 40, "ice_light", 2)
	c.line(6, 33, 5, 42, "ice", 2)
	c.poly([[68, 70], [73, 66], [80, 66], [85, 71]], "slate")
	c.line(71, 67, 78, 66, "white", 2)


static func _unknown(c: RefCounted) -> void:
	c.rect(0, 0, 160, 72, "navy")
	c.disc(115, 15, 7, "gold")
	c.poly([[0, 50], [28, 21], [42, 35], [69, 13], [100, 45], [121, 26],
		[160, 49], [160, 72], [0, 72]], "slate")
	c.poly([[48, 35], [69, 13], [88, 32], [76, 28], [68, 23], [59, 31]], "steel")
	c.poly([[0, 60], [29, 45], [50, 54], [88, 45], [121, 55], [160, 44],
		[160, 72], [0, 72]], "pine")
	c.poly([[76, 45], [81, 45], [69, 57], [89, 65], [84, 72], [66, 72],
		[76, 65], [59, 57]], "gold_dark")
	for x in [8, 20, 138, 150]:
		_pine(c, x, 34, 33, "ink", "navy")


static func _pine(c: RefCounted, x: int, y: int, height: int, shade: String, light: String) -> void:
	c.rect(x - 1, y + 5, 2, height, shade)
	c.poly([[x, y], [x + 5, y + 12], [x + 3, y + 12], [x + 8, y + 21],
		[x + 5, y + 21], [x + 10, y + height], [x - 10, y + height],
		[x - 5, y + 21], [x - 8, y + 21], [x - 3, y + 12], [x - 5, y + 12]], shade)
	c.line(x - 2, y + 7, x - 5, y + 12, light)
	c.line(x - 3, y + 16, x - 7, y + 21, light)


static func _tree(c: RefCounted, x: int, y: int, height: int, width: int) -> void:
	c.poly([[x, y], [x + width, y], [x + width - 1, y + 35],
		[x + width + 8, y + height], [x + 3, y + height - 2],
		[x - 7, y + height], [x - 1, y + 32]], "ink")
	c.poly([[x + 2, y], [x + 5, y], [x + 4, y + 35],
		[x + 8, y + height - 4], [x + 1, y + height - 7]], "earth")
	c.line(x + 2, y + 22, x + 1, y + 43, "earth_light")
	c.line(x + 4, y + 23, x + 20, y + 9, "ink", 3)
	c.line(x, y + 17, x - 12, y + 10, "ink", 3)


static func _fern(c: RefCounted, x: int, y: int) -> void:
	c.line(x, y, x, y - 7, "moss")
	c.line(x, y - 2, x - 5, y - 5, "moss", 2)
	c.line(x, y - 3, x + 5, y - 6, "moss", 2)
	c.line(x, y - 3, x - 4, y - 7, "leaf")
	c.line(x, y - 4, x + 4, y - 8, "leaf")
